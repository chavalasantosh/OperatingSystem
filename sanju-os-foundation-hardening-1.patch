+fn optional_physical_address(pointer: *mut c_void) -> OptionalPhysicalAddress {
+    if pointer.is_null() {
+        return OptionalPhysicalAddress::ABSENT;
+    }
+    OptionalPhysicalAddress {
+        present: 1,
+        reserved: [0; 7],
+        address: u64::try_from(pointer.addr()).unwrap_or(u64::MAX),
+    }
